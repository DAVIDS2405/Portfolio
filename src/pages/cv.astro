---
import { cv, formatRange, profileUrl } from "@lib/cv";
import ArrowLeft from "@icons/ArrowLeft.astro";

export const prerender = true;

const { basics } = cv;
const linkedin = profileUrl("LinkedIn");
const github = profileUrl("GitHub");
const location = [basics.location?.city, basics.location?.countryCode]
  .filter(Boolean)
  .join(", ");
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>CV — {basics.name}</title>
    <meta name="robots" content="noindex" />
  </head>
  <body>
    <a class="back-button" href="/">
      <ArrowLeft />
      Volver al inicio
    </a>

    <button class="print-button" type="button" onclick="window.print()">
      Guardar como PDF
    </button>

    <p class="print-hint">
      Antes de guardar, desactivá <strong>«Encabezados y pies de página»</strong>
      en el diálogo de impresión. Así no salen la URL, la fecha ni el número de
      página.
    </p>

    <main class="sheet">
      <header class="cv-header">
        <div class="identity">
          <h1>{basics.name}</h1>
          <p class="label">{basics.label}</p>
          <ul class="contact">
            {basics.email && <li><a href={`mailto:${basics.email}`}>{basics.email}</a></li>}
            {basics.phone && <li>{basics.phone}</li>}
            {location && <li>{location}</li>}
            {github && <li><a href={github}>{github.replace("https://", "")}</a></li>}
            {linkedin && <li><a href={linkedin}>{linkedin.replace("https://www.", "")}</a></li>}
          </ul>
        </div>
      </header>

      {basics.summary && (
        <section>
          <h2>Resumen profesional</h2>
          <p>{basics.summary}</p>
        </section>
      )}

      {
        cv.work.length > 0 && (
          <section>
            <h2>Experiencia profesional</h2>
            {cv.work.map((job) => (
              <article class="entry">
                <div class="entry-head">
                  <h3>
                    {job.position}
                    {job.url && (
                      <>
                        {" — "}
                        <a href={job.url}>{job.name}</a>
                      </>
                    )}
                  </h3>
                  <span class="dates">
                    {formatRange(job.startDate, job.endDate)}
                  </span>
                </div>
                {!job.url && <p class="company">{job.name}</p>}
                {job.summary && <p>{job.summary}</p>}
                {job.links && job.links.length > 0 && (
                  <ul class="links">
                    {job.links.map((item) => (
                      <li>
                        <a href={item.url}>{item.label} ↗</a>
                      </li>
                    ))}
                  </ul>
                )}
                {job.highlights && job.highlights.length > 0 && (
                  <ul>
                    {job.highlights.map((item) => (
                      <li>{item}</li>
                    ))}
                  </ul>
                )}
              </article>
            ))}
          </section>
        )
      }

      {
        cv.education.length > 0 && (
          <section>
            <h2>Educación</h2>
            {cv.education.map((edu) => (
              <article class="entry">
                <div class="entry-head">
                  <h3>{[edu.studyType, edu.area].filter(Boolean).join(" en ")}</h3>
                  {(edu.startDate || edu.endDate) && (
                    <span class="dates">
                      {formatRange(edu.startDate, edu.endDate)}
                    </span>
                  )}
                </div>
                <p class="company">{edu.institution}</p>
              </article>
            ))}
          </section>
        )
      }

      {
        cv.skills.length > 0 && (
          <section>
            <h2>Habilidades</h2>
            <ul class="skills">
              {cv.skills.map((skill) => (
                <li>
                  <strong>{skill.name}:</strong>{" "}
                  {(skill.keywords ?? []).join(", ")}
                </li>
              ))}
            </ul>
          </section>
        )
      }

      {
        cv.projects.length > 0 && (
          <section>
            <h2>Proyectos</h2>
            {cv.projects.map((project) => (
              <article class="entry">
                <div class="entry-head">
                  <h3>{project.name}</h3>
                  {(project.url || project.repository) && (
                    <a class="dates" href={project.url || project.repository}>
                      {(project.url || project.repository)?.replace("https://", "")}
                    </a>
                  )}
                </div>
                {project.description && <p>{project.description}</p>}
                {project.keywords && project.keywords.length > 0 && (
                  <p class="keywords">{project.keywords.join(" · ")}</p>
                )}
              </article>
            ))}
          </section>
        )
      }
    </main>
  </body>
</html>

<style is:global>
  :root {
    color-scheme: light;
  }

  body {
    margin: 0;
    background: #e5e5e5;
    color: #111827;
    font-family:
      -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue",
      Arial, sans-serif;
    font-size: 10.5pt;
    line-height: 1.45;
  }

  .sheet {
    width: 210mm;
    min-height: 297mm;
    margin: 24px auto;
    padding: 16mm;
    box-sizing: border-box;
    background: #fff;
    box-shadow: 0 8px 30px rgb(0 0 0 / 18%);
  }

  .print-button {
    position: fixed;
    right: 24px;
    bottom: 24px;
    padding: 12px 18px;
    border: 0;
    border-radius: 9999px;
    background: #111827;
    color: #fff;
    font: inherit;
    cursor: pointer;
    box-shadow: 0 6px 20px rgb(0 0 0 / 25%);
  }

  .back-button {
    position: fixed;
    left: 24px;
    bottom: 24px;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 12px 18px;
    border-radius: 9999px;
    background: #fff;
    color: #111827;
    text-decoration: none;
    cursor: pointer;
    box-shadow: 0 6px 20px rgb(0 0 0 / 25%);
  }

  .back-button svg {
    width: 16px;
    height: 16px;
    flex-shrink: 0;
  }

  .back-button:hover {
    background: #111827;
    color: #fff;
  }

  .print-hint {
    position: fixed;
    left: 50%;
    bottom: 24px;
    transform: translateX(-50%);
    width: max-content;
    max-width: min(420px, calc(100vw - 340px));
    margin: 0;
    padding: 10px 16px;
    border-radius: 12px;
    background: rgb(17 24 39 / 92%);
    color: #fff;
    font-size: 8.5pt;
    line-height: 1.35;
    text-align: center;
    box-shadow: 0 6px 20px rgb(0 0 0 / 25%);
  }

  .cv-header {
    display: flex;
    gap: 16px;
    align-items: center;
    padding-bottom: 12px;
    border-bottom: 2px solid #111827;
  }

  h1 {
    margin: 0;
    font-size: 19pt;
    line-height: 1.15;
    letter-spacing: -0.01em;
  }

  .label {
    margin: 2px 0 6px;
    font-size: 10pt;
    color: #b91c1c;
    font-weight: 600;
  }

  .contact {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 12px;
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: 8.5pt;
    color: #4b5563;
  }

  a {
    color: inherit;
    text-decoration: none;
  }

  section {
    margin-top: 14px;
  }

  h2 {
    margin: 0 0 6px;
    font-size: 9pt;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: #b91c1c;
    border-bottom: 1px solid #e5e7eb;
    padding-bottom: 3px;
  }

  .entry {
    margin-bottom: 10px;
    break-inside: avoid;
  }

  .entry-head {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    align-items: baseline;
  }

  h3 {
    margin: 0;
    font-size: 10.5pt;
    font-weight: 700;
  }

  .dates {
    flex-shrink: 0;
    font-size: 8.5pt;
    color: #6b7280;
    white-space: nowrap;
  }

  .company {
    margin: 1px 0 3px;
    font-size: 9.5pt;
    font-weight: 600;
    color: #374151;
  }

  p {
    margin: 3px 0;
  }

  ul {
    margin: 4px 0 0;
    padding-left: 18px;
    list-style: disc;
  }

  li {
    margin-bottom: 2px;
    padding-left: 2px;
  }

  li::marker {
    color: #b91c1c;
  }

  .skills {
    margin-top: 2px;
    padding-left: 0;
  }

  .skills li {
    list-style: none;
    margin-left: 0;
    padding-left: 0;
  }

  .keywords {
    font-size: 8.5pt;
    color: #6b7280;
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 2px 12px;
    margin: 2px 0 0;
    padding: 0;
    list-style: none;
    font-size: 8.5pt;
    color: #6b7280;
  }

  .links li {
    margin: 0;
    list-style: none;
  }

  @media screen and (max-width: 820px) {
    body {
      background: #fff;
    }

    .sheet {
      width: auto;
      min-height: auto;
      margin: 0;
      padding: 20px 16px 80px;
      box-shadow: none;
    }

    .back-button,
    .print-button {
      bottom: 16px;
      padding: 10px 14px;
      font-size: 9pt;
    }

    .back-button {
      left: 12px;
    }

    .print-button {
      right: 12px;
    }

    .print-hint {
      bottom: 84px;
      max-width: calc(100vw - 32px);
    }
  }

  @media print {
    @page {
      size: A4;
      margin: 10mm;
    }

    body {
      background: #fff;
      font-size: 9pt;
      line-height: 1.27;
    }

    .sheet {
      width: auto;
      min-height: auto;
      margin: 0;
      padding: 0;
      box-shadow: none;
    }

    .print-button,
    .back-button,
    .print-hint {
      display: none;
    }

    .cv-header {
      padding-bottom: 8px;
    }

    h1 {
      font-size: 16pt;
    }

    .label {
      font-size: 9pt;
      margin: 1px 0 4px;
    }

    .contact {
      font-size: 7.5pt;
      gap: 3px 10px;
    }

    section {
      margin-top: 8px;
    }

    h2 {
      font-size: 8pt;
      margin-bottom: 3px;
      padding-bottom: 2px;
    }

    .entry {
      margin-bottom: 5px;
    }

    h3 {
      font-size: 9.5pt;
    }

    .company {
      font-size: 8.5pt;
      margin: 0 0 2px;
    }

    p {
      margin: 1.5px 0;
    }

    ul {
      margin-top: 2px;
      padding-left: 14px;
    }

    li {
      margin-bottom: 1px;
    }

    .dates {
      font-size: 7.5pt;
    }

    .links,
    .keywords {
      font-size: 7.5pt;
      margin-top: 1px;
    }
  }
</style>
