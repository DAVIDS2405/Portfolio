---
import BriefCase from "@icons/BriefCase.astro";
import ExperienceItem from "./ExperienceItem.astro";
import { cv, formatRange } from "@lib/cv";
---

<div class="flex flex-row gap-x-4 items-center mb-5">
  <BriefCase class="size-10" />
  <h2>Experiencia Laboral</h2>
</div>
<ol class="relative ml-4 px-6 border-s border-gray-100">
  {
    cv.work.map((job) => (
      <li>
        <ExperienceItem
          date={formatRange(job.startDate, job.endDate)}
          title={job.position}
          company={job.name}
          description={job.summary ?? ""}
          link={job.url || undefined}
          links={job.links}
        />
      </li>
    ))
  }
</ol>
