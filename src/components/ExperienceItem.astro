---
interface Props {
  date: string;
  title: string;
  description: string;
  company: string;
  link?: string;
  links?: { label: string; url: string }[];
}
const { date, title, description, company, link, links } = Astro.props;
---

<div
  class="absolute size-3 bg-red-300 rounded-full mt-1.5 -start-1.5 border border-white dark:border-gray-900"
>
</div>

<div class="flex flex-col lg:flex-row">
  <div class="flex flex-col w-full gap-y-2 mr-5">
    <h2 class="text-xs w-fit text-gray-900 dark:text-red-300">
      {title}
    </h2>

    <h3 class="text-[0.70rem] text-gray-900 dark:text-white">
      {
        link ? (
          <a
            href={link}
            target="_blank"
            rel="noopener noreferrer"
            class="underline decoration-dotted underline-offset-4 transition hover:text-red-300"
          >
            {company}
          </a>
        ) : (
          company
        )
      }
    </h3>
    <time
      class="mb-8 text-[0.70rem] leading-none text-gray-400 dark:text-gray-300"
      >{date}</time
    >
  </div>
  <div class="flex flex-col items-center">
    <p
      class="mb-2 text-[0.70rem] text-pretty max-w-6xl text-gray-500 dark:text-gray-300"
    >
      {description}
    </p>
    {
      links && links.length > 0 && (
        <div class="flex flex-wrap w-full gap-x-4 gap-y-2 mb-4 text-[0.65rem]">
          {links.map((item) => (
            <a
              href={item.url}
              target="_blank"
              rel="noopener noreferrer"
              class="text-gray-400 underline decoration-dotted underline-offset-4 transition hover:text-red-300"
            >
              {item.label} ↗
            </a>
          ))}
        </div>
      )
    }
  </div>
</div>
