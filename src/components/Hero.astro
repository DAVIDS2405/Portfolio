---
import Mail from "@icons/Mail.astro";
import Badge from "./Badge.astro";
import LinkedIn from "@icons/LinkedIn.astro";
import GitHub from "@icons/GitHub.astro";
import Avatar from "./Avatar.astro";
import { cv, highlightLabel, profileUrl } from "@lib/cv";

const { basics } = cv;
const linkedin = profileUrl("LinkedIn");
const github = profileUrl("GitHub");
const firstName = basics.name.split(" ")[0];
---

<div class="flex items-center gap-4 mb-4">
  <Avatar
    class="size-20 rounded-full"
    alt={`Foto de ${basics.name}`}
    loading="eager"
    width={200}
    height={200}
  />
  <div class="flex flex-col items-center">
    {linkedin && (
      <a href={linkedin} target="_blank" class="mb-2">
        <Badge>¡Bienvenido!</Badge>
      </a>
    )}
    <nav class="flex flex-wrap items-start w-full gap-x-4">
      <a
        href={`mailto:${basics.email}`}
        target="_blank"
        class="flex flex-row items-center gap-x-3 justify-center border rounded-full p-2 border-gray-600"
        aria-label="Mail"
      >
        <Mail class="size-6" />
      </a>
      {github && (
        <a
          href={github}
          target="_blank"
          class="flex flex-row items-center gap-x-3 justify-center border rounded-full p-2 border-gray-600"
          aria-label="GitHub"
        >
          <GitHub class="size-6" />
        </a>
      )}
      {linkedin && (
        <a
          href={linkedin}
          target="_blank"
          class="flex flex-row items-center gap-x-3 justify-center border rounded-full p-2 border-gray-600"
          aria-label="LinkedIn"
        >
          <LinkedIn class="size-6" />
        </a>
      )}
    </nav>
  </div>
</div>

<h1 class="text-lg mb-4">Hey, Soy {firstName}</h1>
<h2
  class="text-sm leading-relaxed"
  set:html={highlightLabel(basics.summary, basics.label)}
/>
